#!/bin/sh

# Run pass-cli as pandoks@example.com, or as manda@example.com with --manda.
# Each session dir gets its own keychain key, so the two logins stay separate.

set -eu

session=pandoks
if [ "${1-}" = --manda ]; then
  session=manda
  shift
fi

PROTON_PASS_SESSION_DIR="$HOME/grok/config/proton-pass/$session"
export PROTON_PASS_SESSION_DIR
exec pass-cli "$@"
