#!/bin/sh

# Read and draft Proton Mail through the local Bridge with himalaya. Nothing can
# be sent: the config has no SMTP, and only the subcommands below run.

set -eu

usage() {
  cat >&2 << 'EOF'
usage: grok-proton-mail [-a ACCOUNT] COMMAND SUBCOMMAND [OPTIONS...]

Accounts: proton (default), manda. Read and draft only:
  envelope list|search            mailbox list
  message read                    attachment list|download
  message compose|reply|forward   prints the message; --save only to drafts
  message add -m drafts           flag add|set|remove (not deleted)
  account list|check
EOF
  exit 2
}

deny() {
  echo "grok-proton-mail: '$*' is not allowed: read and draft only" >&2
  exit 1
}

is_drafts() {
  case $1 in
    [Dd][Rr][Aa][Ff][Tt][Ss]) return 0 ;;
  esac
  return 1
}

account=
case "${1-}" in
  -a | --account)
    [ $# -ge 2 ] || usage
    account=$2
    shift 2
    ;;
  --account=*)
    account=${1#--account=}
    shift
    ;;
esac

case "${1-} ${2-}" in
  'envelope list' | 'envelope search' | 'mailbox list' | 'message read') ;;
  'attachment list' | 'attachment download' | 'account list' | 'account check') ;;
  'flag add' | 'flag set' | 'flag remove') ;;
  'message compose' | 'message reply' | 'message forward' | 'message add') ;;
  '-V ' | '--version ') exec himalaya --version ;;
  ' ' | '-h ' | '--help ' | 'help ') usage ;;
  *) deny "${1-} ${2-}" ;;
esac
command="$1 $2"

help=false
previous=
for arg; do
  case $previous in
    --save) is_drafts "$arg" || deny "--save $arg" ;;
    -m | --mailbox)
      [ "$command" != 'message add' ] || is_drafts "$arg" || deny "$command -m $arg"
      ;;
    --log-level | --log)
      case $arg in
        debug | trace) deny "$previous $arg" ;;
      esac
      ;;
  esac
  case $arg in
    --send | --send=* | -c | -c?* | --config | --config=* | --log-file | --log-file=*)
      deny "$arg"
      ;;
    --log-level=debug | --log-level=trace | --log=debug | --log=trace) deny "$arg" ;;
    --save=*) is_drafts "${arg#--save=}" || deny "$arg" ;;
    -h | --help) help=true ;;
  esac
  if [ "$command" = 'message add' ]; then
    # Only `-m drafts` and `--mailbox drafts`, checked above
    case $arg in
      --mailbox=*) deny "$arg" ;;
      -m | --*) ;;
      -*m*) deny "$arg" ;;
    esac
  fi
  # \Deleted is a delete: the next expunge removes the message
  case "$command:$arg" in
    'flag add:'*[Dd][Ee][Ll][Ee][Tt][Ee][Dd]* | 'flag set:'*[Dd][Ee][Ll][Ee][Tt][Ee][Dd]*)
      deny "$command $arg"
      ;;
  esac
  previous=$arg
done

if [ "$help" = false ] && [ "$command" != 'account list' ] \
  && ! nc -z -G 2 127.0.0.1 1143 2> /dev/null; then
  echo "grok-proton-mail: Proton Mail Bridge isn't listening on 127.0.0.1:1143." \
    "Check 'launchctl print gui/$(id -u)/dev.mise.proton-bridge'" \
    "and ~/grok/logs/proton-bridge.log" >&2
  exit 1
fi

# Debug and trace logs can include the IMAP login
unset RUST_LOG
exec himalaya -c "$HOME/grok/config/himalaya/config.toml" ${account:+--account "$account"} "$@"
