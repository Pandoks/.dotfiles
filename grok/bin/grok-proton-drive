#!/bin/sh

# List, read and copy files inside the Proton Drive folder, and nowhere else.
# Reading a cloud-only placeholder downloads it first, which can take a while.

set -eu

root="$HOME/Library/CloudStorage/ProtonDrive-pandoks@example.com-folder"
download_timeout=120

usage() {
  cat >&2 << 'EOF'
usage: grok-proton-drive ls [PATH]
       grok-proton-drive cat FILE
       grok-proton-drive cp SOURCE DEST

PATH, FILE, SOURCE and DEST are relative to the Proton Drive folder, or
absolute paths inside it. cp never overwrites. In ls, a "dataless" flag marks a
cloud-only placeholder.
EOF
  exit 2
}

fail() {
  echo "grok-proton-drive: $*" >&2
  exit 1
}

root=$(realpath "$root" 2> /dev/null) || fail "no Proton Drive folder; is Proton Drive signed in?"

# Print the resolved path of $1, refusing anything outside the Drive folder
inside() {
  case $1 in
    /*) path=$1 ;;
    *) path="$root/$1" ;;
  esac
  path=$(realpath "$path") || exit 1
  case "$path/" in
    "$root"/*) printf '%s\n' "$path" ;;
    *) fail "$1 is outside the Proton Drive folder" ;;
  esac
}

# Run a command that reads $1, giving a placeholder time to download
reading() {
  file=$1
  shift
  case ",$(stat -f %Sf "$file")," in
    *,dataless,*) echo "grok-proton-drive: downloading ${file#"$root"/}..." >&2 ;;
  esac
  status=0
  perl -e 'alarm shift; exec @ARGV or die "$!\n"' "$download_timeout" "$@" || status=$?
  # 142 is death by SIGALRM
  [ "$status" -ne 142 ] || fail "no download after ${download_timeout}s; retry later"
  return "$status"
}

case "${1-}" in
  ls)
    [ $# -le 2 ] || usage
    path=$(inside "${2:-.}")
    ls -lO "$path"
    ;;
  cat)
    [ $# -eq 2 ] || usage
    file=$(inside "$2")
    [ -f "$file" ] || fail "$2 is not a file"
    reading "$file" cat -- "$file"
    ;;
  cp)
    [ $# -eq 3 ] || usage
    source=$(inside "$2")
    case $3 in
      /*) dest=$3 ;;
      *) dest="$root/$3" ;;
    esac
    [ ! -d "$dest" ] || dest="$dest/$(basename -- "$source")"
    [ ! -e "$dest" ] && [ ! -L "$dest" ] || fail "$dest already exists"
    parent=$(inside "$(dirname -- "$dest")")
    reading "$source" cp -R -- "$source" "$parent/$(basename -- "$dest")"
    ;;
  *) usage ;;
esac
