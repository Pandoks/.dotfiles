downloads-dir = "~/grok/cache/proton-mail"
envelope.list.datetime-local-tz = true
message.send.save-copy = false

mailbox.alias.inbox = "INBOX"
mailbox.alias.sent = "Sent"
mailbox.alias.drafts = "Drafts"
mailbox.alias.trash = "Trash"
mailbox.alias.junk = "Spam"
mailbox.alias.archive = "Archive"
{%- set_global first = true %}
{%- for raw in vars.GROK_PROTON_EMAILS | default(value="") | split(pat=",") %}
{%- set email = raw | trim %}
{%- if email %}

[accounts."{{ email | lower }}"]
default = {{ first }}
{%- set_global first = false %}
email = "{{ email }}"
imap.server = "imap://127.0.0.1:1143"
imap.starttls = true
imap.tls.provider = "rustls"
imap.tls.cert = "~/grok/config/himalaya/proton-bridge-cert.pem"
imap.sasl.plain.username = "{{ email }}"
imap.sasl.plain.password.command = [
  "security", "find-generic-password", "-w",
  "-s", "grok-proton-bridge", "-a", "{{ email }}",
]
smtp.server = "smtp://127.0.0.1:1025"
smtp.starttls = true
smtp.tls.provider = "rustls"
smtp.tls.cert = "~/grok/config/himalaya/proton-bridge-cert.pem"
smtp.sasl.plain.username = "{{ email }}"
smtp.sasl.plain.password.command = [
  "security", "find-generic-password", "-w",
  "-s", "grok-proton-bridge", "-a", "{{ email }}",
]
{%- endif %}
{%- endfor %}
