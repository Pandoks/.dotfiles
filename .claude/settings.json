{
  "model": "claude-opus-5-5",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "modelPicker": {
    "options": [
      {
        "model": "red-snow-5.3-flash[1m]",
        "label": "RED-SNOW 5.3 Flash",
        "description": "DeepInfra · scales to zero when idle"
      }
    ]
  },
  "plansDirectory": ".claude/plans",
  "tui": "fullscreen",
  "showThinkingSummaries": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "editorMode": "vim",
  "remoteControlAtStartup": true,
  "skipAutoPermissionPrompt": true,
  "agentPushNotifEnabled": true,
  "cleanupPeriodDays": 90,
  "env": {
    "ANTHROPIC_BASE_URL": "https://cliproxyapi.tailb2c81d.ts.net",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/subagent-model"
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "Bash(docker compose *)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf $HOME:*)",
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)"
    ],
    "defaultMode": "auto"
  },
  "worktree": {
    "baseRef": "head"
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/statusline.sh"
  }
}
