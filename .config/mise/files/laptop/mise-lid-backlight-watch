#!/bin/sh
# Listen to existing logind notifications without installing another daemon.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
export LC_ALL=C SYSTEMD_COLORS=0 SYSTEMD_LOG_TARGET=console
export SYSTEMD_LOG_LEVEL=info
helper=/usr/local/libexec/mise-lid-backlight
base="type='signal',sender='org.freedesktop.login1',path='/org/freedesktop/login1'"
# The ready message is emitted after BecomeMonitor succeeds. Query only then,
# so closing the lid during startup cannot fall between query and subscription.
busctl --system \
    --match="$base,interface='org.freedesktop.DBus.Properties',member='PropertiesChanged',arg0='org.freedesktop.login1.Manager'" \
    --match="$base,interface='org.freedesktop.login1.Manager',member='PrepareForSleep'" \
    --match="$base,interface='org.freedesktop.login1.Manager',member='SessionNew'" \
    --match="$base,interface='org.freedesktop.login1.Manager',member='SessionRemoved'" \
    --match="type='signal',sender='org.freedesktop.login1',path_namespace='/org/freedesktop/login1/session',interface='org.freedesktop.DBus.Properties',member='PropertiesChanged'" \
    --match="type='signal',sender='org.freedesktop.DBus',interface='org.freedesktop.DBus',member='NameOwnerChanged',arg0='org.freedesktop.login1'" \
    monitor 2>&1 |
while IFS= read -r line; do
    case "$line" in
        *'Monitoring bus message stream.'*|*'Member=PropertiesChanged'*|*'Member=PrepareForSleep'*|*'Member=NameOwnerChanged'*|*'Member=SessionNew'*|*'Member=SessionRemoved'*)
            "$helper" sync || printf 'mise-lid-backlight: reconcile failed\n' >&2
            ;;
        *'Failed '*|*'Connection terminated'*) printf '%s\n' "$line" >&2 ;;
    esac
done
# Restart even if monitor exits successfully after its bus disconnects.
exit 1
