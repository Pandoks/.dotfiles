#!/bin/sh
# Controls headless laptop panel backlights; power policy belongs to logind.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077

state=/var/lib/mise-lid-backlight
mkdir -p "$state"
exec 9>/run/mise-lid-backlight.lock
flock 9

# Defer to graphical sessions and applications owning the lid switch. Failed
# queries retain snapshots for a later retry without changing the panel.
headless() {
    inhibited=$(busctl --system --timeout=2 --auto-start=no get-property \
        org.freedesktop.login1 /org/freedesktop/login1 \
        org.freedesktop.login1.Manager BlockInhibited 2>/dev/null) || return 2
    case "$inhibited" in
        's "'*'"') inhibited=${inhibited#s \"}; inhibited=${inhibited%\"} ;;
        *) return 2 ;;
    esac
    case ":$inhibited:" in *:handle-lid-switch:*) return 1 ;; esac
    sessions=$(loginctl list-sessions --no-legend --no-pager 2>/dev/null) || return 2
    while read -r session remainder; do
        [ -n "$session" ] || continue
        kind=$(loginctl show-session "$session" -p Type --value --no-pager 2>/dev/null) || return 2
        case "$kind" in x11|wayland|mir) return 1 ;; esac
    done <<EOF
$sessions
EOF
}

number() {
    case "$1" in ''|*[!0-9]*) return 1 ;; esac
}

internal() {
    path=$(readlink -f "$1") || return 1
    case "$path" in
        */usb[0-9]*/*) return 1 ;;
        */card[0-9]*-eDP-*/*|*/card[0-9]*-LVDS-*/*|*/card[0-9]*-DSI-*/*) return 0 ;;
        */card[0-9]*-DP-*/*|*/card[0-9]*-HDMI-*/*|*/card[0-9]*-VGA-*/*|*/card[0-9]*-DVI-*/*) return 1 ;;
        */platform/thinkpad_acpi/*)
            # Kernel documentation forbids mixing these legacy controls with
            # ACPI-video brightness controls on the same ThinkPad panel.
            for acpi_device in /sys/class/backlight/acpi_video*; do
                [ ! -d "$acpi_device" ] || return 1
            done
            return 0
            ;;
    esac
    # The class has no universal internal-panel flag. Only an administrator's
    # verified internal-device allowlist may include otherwise unmapped devices.
    if [ -r /etc/mise-lid-backlight.devices ]; then
        while IFS= read -r selected || [ -n "$selected" ]; do
            [ "$selected" != "${1##*/}" ] || return 0
        done < /etc/mise-lid-backlight.devices
    fi
    return 1
}

lid_state() {
    # logind maintains the evdev switch state, unlike potentially stale _LID.
    value=$(busctl --system --timeout=2 --auto-start=no get-property \
        org.freedesktop.login1 /org/freedesktop/login1 \
        org.freedesktop.login1.Manager LidClosed 2>/dev/null) || value=
    case "$value" in 'b true') printf '%s\n' close; return ;; 'b false') printf '%s\n' open; return ;; esac
    found=no
    for file in /proc/acpi/button/lid/*/state; do
        [ -r "$file" ] || continue
        value=$(cat "$file") || continue
        case "$value" in *closed) printf '%s\n' close; return ;; *open) found=yes ;; esac
    done
    [ "$found" = no ] || printf '%s\n' open
}

compatible() {
    [ -f "$state/$name" ] || return 1
    {
        IFS= read -r saved_brightness
        IFS= read -r saved_power
        IFS= read -r saved_max
        IFS= read -r saved_path
    } < "$state/$name" || return 1
    number "$saved_brightness" && number "$saved_max" || return 1
    case "$saved_power" in -) ;; *) number "$saved_power" || return 1 ;; esac
    [ "$saved_path" = "$(readlink -f "$device")" ] && \
        [ "$saved_max" = "$(cat "$device/max_brightness")" ]
}

restore() {
    restore_failed=false
    for record in "$state"/*; do
        [ -f "$record" ] || continue
        name=${record##*/}
        device=/sys/class/backlight/$name
        [ -d "$device" ] || continue
        if ! compatible; then
            printf 'mise-lid-backlight: skipping changed device %s\n' "$name" >&2
            continue
        fi
        ok=yes
        if ! printf '%s\n' "$saved_brightness" > "$device/brightness"; then
            printf 'mise-lid-backlight: could not restore %s brightness\n' "$name" >&2
            ok=no
            restore_failed=true
        fi
        if [ "$saved_power" != - ]; then
            if ! printf '%s\n' "$saved_power" > "$device/bl_power"; then
                printf 'mise-lid-backlight: could not restore %s power\n' "$name" >&2
                ok=no
                restore_failed=true
            fi
        fi
        [ "$ok" != yes ] || rm -f "$record"
    done
    [ "$restore_failed" = false ]
}

close() {
    close_failed=false
    # Snapshot every interface before writing: multiple entries may share hardware.
    for device in /sys/class/backlight/*; do
        [ -d "$device" ] && internal "$device" || continue
        name=${device##*/}
        [ ! -f "$state/$name" ] || continue
        brightness=$(cat "$device/brightness") || continue
        maximum=$(cat "$device/max_brightness") || continue
        number "$brightness" && number "$maximum" || continue
        power=$(cat "$device/bl_power" 2>/dev/null) || power=-
        if [ "$power" != - ]; then number "$power" || continue; fi
        record=$(mktemp "$state/.snapshot.XXXXXX")
        printf '%s\n' "$brightness" "$power" "$maximum" "$(readlink -f "$device")" > "$record"
        mv -f "$record" "$state/$name"
    done
    for device in /sys/class/backlight/*; do
        [ -d "$device" ] && internal "$device" || continue
        name=${device##*/}
        compatible || continue
        # Success of bl_power does not prove hardware support. Zero is a fallback,
        # not a guarantee: some firmware maps level zero to nonzero minimum PWM.
        off_requested=false
        if [ "$saved_power" != - ]; then
            if printf '4\n' > "$device/bl_power"; then
                off_requested=true
            else
                printf 'mise-lid-backlight: %s rejected power off; trying brightness zero\n' "$name" >&2
            fi
        fi
        if printf '0\n' > "$device/brightness"; then
            off_requested=true
        else
            printf 'mise-lid-backlight: %s rejected brightness zero\n' "$name" >&2
        fi
        [ "$off_requested" = true ] || close_failed=true
    done
    [ "$close_failed" = false ]
}

action=${1:-sync}
case "$action" in
    event)
        [ "${2:-}" = button/lid ] || exit 0
        case "${4:-}" in close|closed) action=close ;; open|opened) action=open ;; *) action=sync ;; esac
        ;;
    close|open|sync|restore) ;;
    *) printf 'usage: mise-lid-backlight [sync|close|open|restore|event EVENT...]\n' >&2; exit 2 ;;
esac
if [ "$action" = sync ]; then action=$(lid_state); fi
if headless; then
    :
else
    status=$?
    # Another display controller now owns the panel. Do not later restore an
    # obsolete snapshot over its settings. Never write sysfs in this case.
    [ "$status" != 1 ] || rm -f "$state"/*
    exit 0
fi
case "$action" in close) close ;; open|restore) restore ;; esac
