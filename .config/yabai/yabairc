# make sure to not turn off "Displays have separate Spaces" in System Settings Mission Control

# to get window switching to work, make sure to turn off SIP and enter this command:
# sudo nvram boot-args=-arm64e_preview_abi
# make sure to restart after running nvram

# to give yabai sudo permissions, follow these instructions after each upgrade:
# create a new file for writing - visudo uses the vim editor by default.
# go read about this if you have no idea what is going on.

# sudo visudo -f /private/etc/sudoers.d/yabai

# input the line below into the file you are editing.
#  replace <yabai> with the path to the yabai binary (output of: which yabai).
#  replace <user> with your username (output of: whoami).
#  replace <hash> with the sha256 hash of the yabai binary (output of: shasum -a 256 $(which yabai)).
#   this hash must be updated manually after running brew upgrade.
#
# you can also get the entire line by running this command:
#  echo "$(whoami) ALL=(root) NOPASSWD: sha256:$(shasum -a 256 $(which yabai) | cut -d " " -f 1) $(which yabai) --load-sa"
#
# to automatically change it you can run this command:
#  yabai_string="$(whoami) ALL=(root) NOPASSWD: sha256:$(shasum -a 256 $(which yabai) | cut -d " " -f 1) $(which yabai) --load-sa"
#  echo "$yabai_string" | sudo tee /private/etc/sudoers.d/yabai >/dev/null
#
# you must do this after each upgrade of yabai too

# <user> ALL=(root) NOPASSWD: sha256:<hash> <yabai> --load-sa


# load scriping capabilities
yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa"
sudo yabai --load-sa
yabai -m config window_placement second_child

# bsp, stack, float
yabai -m config layout bsp

# padding
yabai -m config top_padding 0
yabai -m config bottom_padding 0
yabai -m config left_padding 0
yabai -m config right_padding 0
yabai -m config window_gap 0

# whitelist apps to be yabaied
yabai -m rule --add app!="^(Helium|Ghostty|Slack|Notion Calendar|T3 Code \(Nightly\))$" manage=off
yabai -m rule --add app=".*" sub-layer=normal

# label spaces (4, 8, 9 unlabeled)
yabai -m space 1 --label ai
yabai -m space 2 --label terminals
yabai -m space 3 --label personal-browser
yabai -m space 5 --label communication
yabai -m space 6 --label management
yabai -m space 7 --label work

# pin apps to their space at creation
yabai -m rule --add label=ghostty-profiles app="^Ghostty$" title="^(sieve|dev|local)$" space="^terminals"
yabai -m rule --add label=space-t3 app="^T3 Code \(Nightly\)$" space="^ai"
yabai -m rule --add label=space-helium app="^Helium$" space="^personal-browser"
yabai -m rule --add label=space-slack app="^Slack$" space="^communication"
yabai -m rule --add label=space-messages app="^Messages$" space="^management"
yabai -m rule --add label=space-bambu app="^BambuStudio$" space="^management"
yabai -m rule --add label=space-notion-calendar app="^Notion Calendar$" space="^management"
yabai -m rule --add label=space-davinci app="^DaVinci Resolve$" space="^work"
